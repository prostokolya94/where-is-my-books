# ===== Where Is My Books — Backend (пример для продакшена) =====
# Скопируйте в .env на сервере (chmod 600) и заполните РЕАЛЬНЫЕ значения.

# Сервер
PORT=3001
# В продакшене за nginx лучше слушать только localhost:
HOST=127.0.0.1

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wimb
DB_PASSWORD=ЗАМЕНИТЕ_случайной_строкой
DB_NAME=books
# Синхронизация схемы: в продакшене ОБЯЗАТЕЛЬНО false.
# Схему применяйте вручную (см. DEPLOY.md).
DB_SYNC=false

# JWT — сгенерируйте: openssl rand -base64 48
JWT_SECRET=ЗАМЕНИТЕ_сгенерированным_секретом

# CORS: список разрешённых источников через запятую (без пробелов!)
# Например: CORS_ORIGIN=https://books.example.com
CORS_ORIGIN=

# Почта — переключите на smtp в продакшене
MAIL_TRANSPORT=smtp
EMAIL_FROM=Where Is My Books <no-reply@ВАШ_ДОМЕН>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ВАШ_SMTP_ЛОГИН
SMTP_PASS=ВАШ_SMTP_ПАРОЛЬ

# Публичный адрес фронтенда (для ссылок в письмах)
FRONTEND_URL=https://ВАШ_ДОМЕН